# Copy this file to server/.env and add your own API keys.
# Never commit real secrets.
PORT=5000
HOST=127.0.0.1
CLIENT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5000/api/auth/github/callback
API_PUBLIC_URL=http://localhost:5000
# Optional shared session/rate-limit/audit store. Required for distributed use.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# AI quotas: burst limit per user per window and daily ceiling per user.
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=600000
AI_DAILY_QUOTA=200
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: enables local Docker-isolated checks. Keep false unless Docker is installed.
SANDBOX_ENABLED=false
